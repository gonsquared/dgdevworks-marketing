# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local files
docs/*

# sandbox/IDE artifacts observed at repo root in this environment — not real
# project files (confirmed character-special devices via `file`), but
# ignored explicitly so a future `git add -A` can never sweep them in.
# .idea/.vscode have no trailing slash because they're device files here,
# not directories, and a trailing-slash pattern only matches directories.
.idea
.vscode
.claude/
.mcp.json
.bashrc
.bash_profile
.zshrc
.zprofile
.profile
.gitconfig
