# DG DevWorks Marketing Site — environment variables
# Copy this file to `.env.local` for local development and fill in real values
# before production deploy. All variables are NEXT_PUBLIC_* because this is a
# fully static export with no backend/server runtime — nothing here should be
# a genuine secret (see docs/api-contract.md security notes).

# ---- Required (safe placeholder defaults below so the build never fails) ----

# Production domain used to build canonical URLs, sitemap.xml, robots.txt,
# and Open Graph metadata. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.dgdevworks.com

# Discord incoming webhook URL that receives contact form submissions
# (POSTed client-side with ?wait=true — see docs/api-contract.md).
# The placeholder below is intentionally invalid; the contact form detects
# this placeholder and short-circuits instead of attempting a request.
NEXT_PUBLIC_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/PLACEHOLDER/PLACEHOLDER

# Booking/scheduling link used by every "Book a call" CTA sitewide.
# Replace with a real Calendly (or equivalent) link before launch.
NEXT_PUBLIC_BOOKING_URL=https://cal.com/dgdevworks/placeholder

# ---- Optional ----

# Google Search Console ownership verification token (meta tag value).
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# Google Analytics Measurement ID (e.g. G-XXXXXXXXXX). Leave unset to disable analytics.
NEXT_PUBLIC_GA_ID=
